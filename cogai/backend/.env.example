# demo: no external API calls; live: requires explicit external-processing consent
COGAI_MODE=demo
COGAI_ENVIRONMENT=development
COGAI_KNOWLEDGE_DEVELOPMENT=false
# Blank disables semantic API retrieval. Configure a model supported by your provider.
COGAI_EMBEDDING_MODEL=
# Optional speech models supported by the same backend provider. Blank = disabled.
COGAI_TRANSCRIPTION_MODEL=
COGAI_SPEECH_MODEL=
COGAI_SPEECH_VOICE=
COGAI_SUPPORT_ACCEPTING=false
COGAI_MAINTENANCE_SECONDS=60
COGAI_LLM_BASE_URL=https://api.openai.com/v1
COGAI_LLM_API_KEY=
COGAI_LLM_MODEL=gpt-4.1-mini
# 0 disables the optional daily call cap. The --live launcher uses 0.
COGAI_EXTERNAL_DAILY_CALL_LIMIT=0
COGAI_LLM_MAX_COMPLETION_TOKENS=1800
COGAI_RESEARCH_DEEP_ENABLED=true
COGAI_VOICE_MAX_RECORDING_SECONDS=45
# edge (default) = the single Mầm voice, same as the MYHealth device demo; sends reply text to
# Microsoft's Edge read-aloud service. openai = COGAI_SPEECH_MODEL/VOICE instead (never mixed).
# azure = the same HoaiMy voice via the official Azure Speech service (steadier latency than
# the free Edge endpoint), falling back to Edge HoaiMy on any Azure error. auto = azure when a key is set, else edge.
COGAI_SPEECH_PROVIDER=edge
COGAI_EDGE_VOICE=vi-VN-HoaiMyNeural
COGAI_EDGE_RATE=+0%
COGAI_AZURE_SPEECH_KEY=
COGAI_AZURE_SPEECH_REGION=southeastasia
# Desk devices (MYHealth/Ricky) on /xiaozhi/ota/ and /xiaozhi/v1/. --device enables it.
COGAI_DEVICE_GATEWAY=false
# mp3 for compatibility; --live uses wav to avoid MP3 encoding latency.
COGAI_SPEECH_FORMAT=mp3
COGAI_DATA_DIR=./data
# Optional Fernet key. Without it, a local key is generated in data/.key.
COGAI_ENCRYPTION_KEY=
COGAI_COOKIE_SECURE=false
COGAI_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000","http://127.0.0.1:7860","http://localhost:7860"]
# Optional verified partner contact. No referral is sent automatically.
COGAI_SUPPORT_NAME=
COGAI_SUPPORT_PHONE=
COGAI_SUPPORT_HOURS=
